# Backend API Base URL (Dùng cho Next.js Rewrites Reverse Proxy trên Cloud hoặc Server Component)
BACKEND_API_URL=http://localhost:3000

# Client API URL (Trình duyệt gọi qua proxy cùng domain, ví dụ /api/v1 trên Production hoặc http://localhost:3000/api/v1 ở Local)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# VietMap Map API Configuration
NEXT_PUBLIC_VIETMAP_API_KEY=your_domain_restricted_vietmap_key_here
NEXT_PUBLIC_VIETMAP_TILEMAP_KEY=your_domain_restricted_vietmap_key_here
NEXT_PUBLIC_VIETMAP_PUBLIC_KEY=your_services_public_key_here

# MSW Mock Configuration (true/false)
NEXT_PUBLIC_ENABLE_MSW=false
